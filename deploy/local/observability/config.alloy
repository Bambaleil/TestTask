loki.source.gelf "payments" {
  listen_address = "0.0.0.0:12201"
  forward_to = [loki.process.payments.receiver]
}

loki.process "payments" {
  // Docker GELF оборачивает строку stdout в собственный JSON-конверт.
  stage.json {
    expressions = {payload = "full_message || short_message"}
  }
  stage.output {
    source = "payload"
  }
  stage.static_labels {
    values = {job = "payments"}
  }
  stage.json {
    expressions = {service = "service", level = "level", timestamp = "timestamp"}
  }
  stage.labels {
    values = {service = "", level = ""}
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
