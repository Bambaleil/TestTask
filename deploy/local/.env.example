# Замените ключ и пароли перед использованием за пределами локальной разработки.
API_KEY=local-development-api-key-change-me
POSTGRES_USER=payments
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=local-rabbit-password
DATABASE_URL=postgresql+asyncpg://payments:local-postgres-password@postgres:5432/payments
RABBITMQ_URL=amqp://payments:local-rabbit-password@rabbitmq:5672/
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=50
PUBLISH_TIMEOUT=5
WEBHOOK_TIMEOUT=5
RETRY_BASE_DELAY=2
LOG_LEVEL=INFO
WORKER_HEALTH_PORT=8081
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password-change-me
